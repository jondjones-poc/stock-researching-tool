# Database (Supabase Postgres pooler)
SUPABASE_DB_PASSWORD=

# Supabase Auth (Google OAuth)
# Google Client ID + Secret go in Supabase Dashboard → Authentication → Providers → Google
# (NOT in this file — the app talks to Supabase only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Legacy service_role JWT (eyJ...), NOT sb_secret_ — Supabase → API → Legacy API Keys
SUPABASE_SERVICE_ROLE_KEY=

# Auth / session
AUTH_ADMIN_EMAILS=you@gmail.com
ALLOWED_AUTH_EMAILS=
# Comma-separated frontend origins (Netlify also auto-detects URL env if unset)
AUTH_ALLOWED_ORIGINS=https://YOUR-APP.netlify.app
# Or set a single origin (alias fallback):
# FRONTEND_ORIGIN=https://YOUR-APP.netlify.app
#
# If API runs on Render but UI on Netlify, set on Netlify:
# NEXT_PUBLIC_AUTH_FLOW_API_ORIGIN=https://YOUR-API.onrender.com
# Cookie lifetime in days (default 7 for desktop; other app used 365)
AUTH_SESSION_MAX_AGE_DAYS=7

# Local dev only (omit on Render)
FRONTEND_DEV_ORIGIN=http://localhost:3000
# Direct API origin for full-page OAuth nav when frontend/API are split (optional)
NEXT_PUBLIC_AUTH_FLOW_API_ORIGIN=http://localhost:3000

# Keepalive (optional)
KEEPALIVE_SECRET=

# External APIs (existing)
FMP_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
ETORO_PUBLIC_KEY=
ETORO_PRIVATE_KEY=
ETORO_ACCOUNT_TYPE=real

# Trading 212 (Contrarian Portfolio at /stocks/portfolio/contrarian)
# Settings → API (Beta): API Key = TRADE_ID, API Secret = TRADE_KEY
# Enable Portfolio (and Account) on the key
TRADE_ID=
TRADE_KEY=
# Optional: live (default) or demo
# TRADE_212_ENV=live
# TRADE_212_BASE_URL=https://live.trading212.com

# Global Market Flow Tracker (/research/markets)
# Set true to use deterministic mock EOD (no FMP calls). Also auto-mocks if FMP_API_KEY is empty.
MARKET_FLOW_MOCK=true
# Optional dedicated cron secret (falls back to KEEPALIVE_SECRET)
MARKET_FLOW_CRON_SECRET=

# Company Finder (/research/company-finder) — SEC User-Agent should identify your app/email
SEC_USER_AGENT=ShareResearchApp company-finder (you@example.com)
COMPANY_FINDER_CRON_SECRET=
# Cloudflare worker path that kicks off a scrape batch (admin "Run scrape batch" button)
# e.g. https://share-research-supabase-keepalive.<account>.workers.dev/company-finder
COMPANY_FINDER_WORKER_URL=

# Homepage stock quote cache (Finnhub → dashboard_stock_quotes), warmed by Cloudflare cron 08:00 UTC
# Optional dedicated cron secret (falls back to KEEPALIVE_SECRET)
DASHBOARD_STOCK_QUOTES_CRON_SECRET=
# Set on the Cloudflare worker as DASHBOARD_STOCK_QUOTES_REFRESH_URL:
# e.g. https://YOUR-API.onrender.com/api/dashboard-watchlist/refresh
